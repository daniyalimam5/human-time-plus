{
  "name": "human-time-plus",
  "version": "1.0.0",
  "description": "Tiny, dependency-free library for human-readable dates, relative times, and durations, including duration parsing (\"1h 30m\" back to milliseconds), a built-in CLI, and English/Urdu localization.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "human-time-plus": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "date",
    "time",
    "duration",
    "duration-parser",
    "ms",
    "relative-time",
    "timeago",
    "humanize",
    "human-readable",
    "cli",
    "typescript",
    "localization",
    "i18n",
    "urdu"
  ],
  "author": "Daniyal Imam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniyalimam5/human-time-plus.git"
  },
  "homepage": "https://github.com/daniyalimam5/human-time-plus#readme",
  "bugs": {
    "url": "https://github.com/daniyalimam5/human-time-plus/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.5",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.0",
    "vitest": "^2.1.3"
  }
}
